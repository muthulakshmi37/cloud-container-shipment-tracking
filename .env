# Copy to .env and change the values before deploying
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=/data/tracking.db
DEVICE_API_KEY=change-me-device-key
TOKEN_MAX_AGE=86400
AVG_SPEED_KMH=24
# Set to your frontend origin if you host the UI separately (e.g. S3/CloudFront)
CORS_ORIGIN=
# Seed demo data on first start (true/false)
SEED_DEMO=true
